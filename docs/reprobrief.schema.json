{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/y4ho0/reprobrief/blob/v0.1.0/docs/reprobrief.schema.json",
  "title": "ReproBrief recipe",
  "description": "A bounded set of argv commands approved for a reproduction brief.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "commands": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/command"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv"
      ],
      "properties": {
        "name": {
          "description": "Portable, case-insensitively unique output key; Windows device names and a trailing dot are rejected at runtime.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "argv": {
          "description": "Program and arguments. {python} is portable only as the first item.",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "default": "."
        },
        "expected_exit_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": -255,
            "maximum": 255
          },
          "default": [
            0
          ]
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 300,
          "default": 30
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 65536
        },
        "inherit_env": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "default": []
        }
      }
    }
  }
}
